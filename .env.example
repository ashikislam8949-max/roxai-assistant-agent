# Required for the streaming assistant. Create this in Vercel AI Gateway.
AI_GATEWAY_API_KEY=
# Optional: defaults to openai/gpt-4o-mini.
AI_MODEL=openai/gpt-4o-mini
# Google OAuth credentials for the private admin sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate a random value, for example with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Set this to the deployed app URL in production.
NEXTAUTH_URL=http://localhost:3000
